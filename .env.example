# `npm run setup` generates AUTH_SECRET in .env.local. Provider variables are
# optional readiness checks only until provider authorization and sync exist.

# Signs the session cookie. Any long random string; keep it secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: override the admin account `npm run setup` creates.
# ADMIN_EMAIL=admin@sparqlabs.ai
# ADMIN_PASSWORD=Use-a-strong-password-12+
# ADMIN_NAME=Portal Admin

# Login throttling. Stubbed by default during the testing phase: set this to
# `on` to count failed sign-ins again and lock an account after five in fifteen
# minutes. Required before the portal is reachable from the internet.
# LOGIN_THROTTLE=on

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
# Enables an additional IP-based login throttle. Both throttles depend on
# LOGIN_THROTTLE above, which is off during the testing phase.
# TRUST_PROXY_IP=false

# Read-only provider metrics. Keep these server-only; never use NEXT_PUBLIC_.
# EmailBison workspace URL, for example https://app.emailbison.com
EMAILBISON_BASE_URL=
EMAILBISON_API_TOKEN=
# GoHighLevel private integration token and the SparqLabs sub-account location ID.
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=

# Optional readiness checks for integrations not yet connected.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
